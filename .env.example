# Copy this file to .env and set every blank value before starting Compose.
# Use URL-safe passwords/tokens (letters, digits, underscore, hyphen).
# Add the public MCP domain to MCP_ALLOWED_HOSTS after the domain is selected.
POSTGRES_DB=ict
POSTGRES_USER=ict_app
POSTGRES_PASSWORD=
DEMO_OPERATOR_TOKEN=
DEMO_VIEWER_TOKEN=
AGENTARTS_MCP_API_KEY=
ICT_INTERNAL_API_KEY=
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
